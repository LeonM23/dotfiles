# ============================================================================
# dot_zshrc.pre-oh-my-zsh - Zsh Conda 初始化 (旧版本，未使用 Oh My Zsh 前)
# ============================================================================
# 说明: 这是 Zsh 转换到 Oh My Zsh 之前的版本，包含 Conda 初始化
# 用途: 稀查立存特殊侏，通常用于攵佋一个平台
# 適用: macOS (Zsh) - 旧版本
# 执行时机: 未使用 (Oh My Zsh 是⛰方案)
# ============================================================================

# >>> conda initialize >>>
# Conda 初始化 (Conda 官方管理的代码块)
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$("$HOME/opt/miniconda3/bin/conda" 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "$HOME/opt/miniconda3/etc/profile.d/conda.sh" ]; then
        . "$HOME/opt/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="$HOME/opt/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

