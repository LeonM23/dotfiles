{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "{{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "foreground": "#26C6DA",
          "type": "os",
          "style": "plain"
        },
        {
          "template": "{{ .UserName }}@{{ .HostName }} ",
          "foreground": "#26C6DA",
          "type": "session",
          "style": "diamond"
        },
        {
          "properties": {
            "style": "full"
          },
          "template": "{{ .Path }} ",
          "foreground": "#77E4F7",
          "type": "path",
          "style": "plain"
        },
        {
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": "{{ .UpstreamIcon }}{{ .HEAD }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "foreground": "#FFE700",
          "type": "git",
          "style": "plain",
          "foreground_templates": [
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#FFCC80{{ end }}",
            "{{ if gt .Ahead 0 }}#16c60c{{ end }}",
            "{{ if gt .Behind 0 }}#f450de{{ end }}"
          ]
        },
        {
          "properties": {
            "display_mode": "context",
            "fetch_virtual_env": true
          },
          "template": "(\ue235 {{ .Venv }})",
          "foreground": "#4584b6",
          "type": "python",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "properties": {
            "always_enabled": true
          },
          "template": "| {{ if gt .Code 0 }}<#ff0000>\uf00d</>{{ else }}<#23d18b>\uf42e</>{{ end }} ",
          "type": "status",
          "style": "plain"
        },
        {
          "properties": {
            "threshold": 10
          },
          "template": "| {{ .FormattedMs }} ",
          "foreground": "#bab02a",
          "type": "executiontime",
          "style": "plain"
        },
        {
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": "| \ue718 {{ .Full }} ",
          "foreground": "#ffffff",
          "background": "#6CA35E",
          "type": "node",
          "style": "diamond"
        },
        {
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": "| \ue738 {{ .Full }} ",
          "foreground": "#ffffff",
          "background": "#4c1f5e",
          "type": "java",
          "style": "diamond"
        },
        {
          "properties": {
            "time_format": "15:04:05"
          },
          "template": "| {{ .CurrentDate | date .Format }} \uf017 ",
          "foreground": "#00C5C7",
          "type": "time",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "❯ ",
          "foreground": "#43D426",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3
}