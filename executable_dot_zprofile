# ============================================================================
# executable_dot_zprofile - Zsh 配置文件初始化
# ============================================================================
# 说明: 这是 Zsh 的初始化文件 (macOS 上的首选)
# 用途: 在每次登陆 shell 启动时初始化 shell 环境
# 適用: macOS (Zsh)
# 执行时机: 打开新的登陆 shell 时加载一次 (比如新的端端窗口)
# ============================================================================

# Homebrew 环境变量初始化
# 加载 Homebrew 的 shell 环境 (Apple Silicon Mac 特定)
eval $(/opt/homebrew/bin/brew shellenv) #ckbrew

# 加载 Zsh 交互式 shell 配置
# .zshrc 包含所有交互式 shell 的配置，如别名、插件等
source ~/.zshrc
