
# ============================================================================
# dot_bash_profile - Bash 初始化配置文件
# ============================================================================
# 说明: 这是 Bash 在 macOS/Linux 上的登陆shell初始化文件
# 用途: 初始化环境变量、PATH设置、Conda/Homebrew配置等
# 适配系统: macOS, Linux (任何使用 bash 的类Unix系统)
# 执行时机: 登陆shell启动时加载一次
# ============================================================================

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
# Conda 初始化: 设置 conda 命令和环境激活功能
__conda_setup="$("$HOME/miniconda3/bin/conda" 'shell.bash' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
        . "$HOME/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="$HOME/miniconda3/bin:$PATH"
    fi
fi

# 加载 bashrc 配置文件: 包含所有 bash 的交互式shell配置
if [ -f ~/.bashrc ]; then
    source ~/.bashrc
fi

# Homebrew GNU工具配置: 优先使用 Homebrew 安装的 GNU 版本工具
# 这样可以使 macOS 上的工具更接近 Linux 环境
if type brew &> /dev/null; then
    HOMEBREW_PREFIX=$(brew --prefix)
    # 添加 GNU 二进制文件到 PATH
    for d in ${HOMEBREW_PREFIX}/opt/*/libexec/gnubin; do
		export PATH=$d:$PATH;
    done;
    # 添加 GNU manual 页面到 MANPATH
    for d in ${HOMEBREW_PREFIX}/opt/*/libexec/gnuman; do
		export MANPATH=$d:$MANPATH;
    done;
fi;

unset __conda_setup
# <<< conda initialize <<<

